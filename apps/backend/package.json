{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile ./src/index.ts --outdir dist",
    "preview": "NODE_ENV=production bun run ./src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsgo --noEmit",
    "db:seed": "bun run ./src/db/seed.ts"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cors": "^1.4.1",
