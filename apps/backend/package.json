{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile ./src/index.ts --outdir dist",
    "preview": "NODE_ENV=production bun run ./src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsgo --noEmit",
    "postinstall": "prisma generate",
    "prisma": "prisma"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "env-var": "^7.5.0",
    "ioredis": "^5.9.2",
    "prismabox": "^1.1.26"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@types/bun": "^1.3.6",
    "@typescript/native-preview": "^7.0.0-dev.20260103.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
