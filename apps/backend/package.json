    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.22",
    "env-var": "^7.5.0",
    "ioredis": "^5.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@types/bun": "^1.3.6",
    "@typescript/native-preview": "^7.0.0-dev.20260103.1",
    "bullmq": "^5.66.5",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.17.1",
    "typescript": "^5.9.3"
  }
