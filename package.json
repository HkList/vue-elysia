{
  "name": "vue-elysia",
  "version": "1.0.0",
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"bun run --filter * dev\"",
    "build": "concurrently -k \"bun run --filter * build\"",
    "preview": "concurrently -k \"bun run --filter * preview\"",
    "lint": "concurrently -k \"bun run --filter * lint\"",
    "lint:fix": "concurrently -k \"bun run --filter * lint --fix\"",
    "typecheck": "concurrently -k \"bun run --filter * typecheck\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.2.1"
  }
}
